# Copy this file to .env and fill in real values. .env is git-ignored.
#
# Fastest path: run `docker compose up postgres` for just the database, then
# these values match its defaults exactly - no separate local Postgres needed.

DATABASE_URL=postgresql://webhooks:webhooks@localhost:5432/webhooks

PORT=3001

# Only read by the worker entrypoint (src/worker.ts). If you run more than
# one worker locally, give each its own .env or WORKER_ID override.
WORKER_ID=worker-local
POLL_INTERVAL_MS=500
LEASE_SECONDS=30

# Optional. Only used by src/paypal/paypal-signature.guard.ts, and only
# when a request actually carries real PayPal signature headers - the
# assessment's own test events don't, so this can stay blank.
PAYPAL_WEBHOOK_ID=<paypal_webhook_id>
